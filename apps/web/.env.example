# Copy to .env.local (the dev script loads it). Never commit real secrets.

# libsql/SQLite file used by Better Auth. It must NOT be a file the Go API opens.
DATABASE_URL=file:dev.db

# Public URL of this app. It becomes the JWT issuer, and the Go API must use the same value.
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Audience claim of the tokens for the Go API. The Go API must use the same value.
AUTH_JWT_AUDIENCE=viteordre-api

# Where the browser reaches the Go API (Encore listens on 4000 in development).
VITE_API_URL=http://localhost:4000
