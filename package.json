{
  "name": "viteordre",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.2.21"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yaml,yml}": [
      "prettier --write"
    ],
    "*.go": [
      "gofmt"
    ]
  }
}
